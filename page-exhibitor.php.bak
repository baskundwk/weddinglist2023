                      'parent' => 0
                    ]);

                    if (!is_wp_error($vendorTypes)) {
                      foreach ($vendorTypes as $vendorType) {
                        echo '<option value="'.$vendorType->name.'">'. $vendorType->name . '</option>' ;
                      }
                    }?>
